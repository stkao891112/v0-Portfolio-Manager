# 複製這個檔案成 .env.local，填入自己的值（.env.local 不會被上傳到 GitHub）
# Vercel 上請到「專案 → Settings → Environment Variables」設定同樣的變數

# Turso 雲端資料庫（在 Vercel 後台 Storage 建立 Turso 資料庫後，會自動產生這兩個值）
# 本機沒填的話，會改用專案內的 data/portfolio.db
# 格式範例：libsql://你的資料庫名稱-你的帳號.turso.io
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# 網站登入密碼（只有 Vercel 上會要求輸入；本機 start.bat 不需要）
APP_PASSWORD=

# 選填：一組長亂數，讓登入憑證更難被偽造
AUTH_SECRET=
